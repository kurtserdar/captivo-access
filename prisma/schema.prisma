// Captivo Access — Manager database schema.
// Slice 1: identity + passkey (User, Passkey, TotpSecret, Invite, Session).
// NOT multi-tenant — single-org self-host.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  VENDOR
}

enum UserStatus {
  ACTIVE
  DISABLED
}

model User {
  id             String        @id @default(cuid())
  email          String        @unique
  name           String
  phone          String?
  company        String?
  role           Role
  status         UserStatus    @default(ACTIVE)
  createdAt      DateTime      @default(now())
  passkeys       Passkey[]
  totp           TotpSecret?
  sessions       Session[]
  invitesCreated Invite[]      @relation("InviteCreator")
  grantsSubject  AccessGrant[] @relation("GrantSubject")
  grantsApproved AccessGrant[] @relation("GrantApprover")
  grantsCreated  AccessGrant[] @relation("GrantCreator")
}

model Passkey {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  credentialId String    @unique // base64url
  publicKey    Bytes // COSE public key (not sensitive — public)
  counter      BigInt    @default(0)
  transports   String[] // usb/nfc/ble/internal/hybrid
  label        String // "iPhone", "Laptop" — user-facing label
  createdAt    DateTime  @default(now())
  lastUsedAt   DateTime?

  @@index([userId])
}

model TotpSecret {
  userId      String    @id // 1:1
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  secret      String // AES-256-GCM encrypted (crypto.ts)
  confirmedAt DateTime? // set once enrollment is verified
}

model Invite {
  id          String    @id @default(cuid())
  email       String
  name        String
  phone       String?
  company     String?
  role        Role
  tokenHash   String    @unique // argon2(random 32B); plaintext only in the link
  expiresAt   DateTime
  usedAt      DateTime?
  createdById String
  createdBy   User      @relation("InviteCreator", fields: [createdById], references: [id])
  createdAt   DateTime  @default(now())

  @@index([email])
}

model Session {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String   @unique // sha256(opaque random); plaintext token lives in the cookie
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())
  userAgent  String?
  ip         String?

  @@index([userId])
}

enum ConnectorStatus {
  PENDING
  ONLINE
  OFFLINE
  REVOKED
}

model Connector {
  id         String          @id @default(cuid())
  name       String
  tokenHash  String          @unique
  status     ConnectorStatus @default(PENDING)
  lastSeenAt DateTime?
  version    String?
  remoteAddr String?
  createdAt  DateTime        @default(now())
  sites      Site[]
}

model ConnectorPairing {
  id        String    @id @default(cuid())
  codeHash  String
  name      String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

model Site {
  id                 String        @id @default(cuid())
  connectorId        String
  connector          Connector     @relation(fields: [connectorId], references: [id], onDelete: Cascade)
  name               String
  hostname           String        @unique
  upstreamUrl        String?
  insecureSkipVerify Boolean       @default(false)
  description        String?
  probedAt           DateTime?
  probeOk            Boolean?
  probeDetail        String?
  probeLatencyMs     Int?
  createdAt          DateTime      @default(now())
  grants             AccessGrant[]
}

enum GrantStatus {
  ACTIVE
  REVOKED
  DENIED
}

model AccessGrant {
  id       String      @id @default(cuid())
  userId   String
  user     User        @relation("GrantSubject", fields: [userId], references: [id], onDelete: Cascade)
  siteId   String
  site     Site        @relation(fields: [siteId], references: [id], onDelete: Cascade)
  startsAt DateTime?
  endsAt   DateTime?
  status   GrantStatus @default(ACTIVE)
  note     String?

  requiresApproval Boolean   @default(false)
  approvedAt       DateTime?
  approvedById     String?
  approvedBy       User?     @relation("GrantApprover", fields: [approvedById], references: [id])

  schedule Json?

  createdById String
  createdBy   User     @relation("GrantCreator", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  @@index([userId, siteId])
}

enum AuditDecision {
  ALLOW
  DENY
}

model AuditEvent {
  id        String        @id @default(cuid())
  timestamp DateTime      @default(now())
  userId    String?
  userEmail String?
  userName  String?
  siteId    String?
  siteName  String?
  host      String
  method    String
  path      String
  status    Int
  bytesOut  BigInt        @default(0)
  decision  AuditDecision
  reason    String?
  clientIp  String?
  userAgent String?
  seq       BigInt        @unique
  prevHash  String        @default("")
  hash      String        @default("")
  createdAt DateTime      @default(now())

  @@index([timestamp])
  @@index([userId, timestamp])
  @@index([siteId, timestamp])
  @@index([seq])
}

// Singleton (id = "singleton") holding the tamper-evidence chain head.
model AuditChainState {
  id        String   @id
  lastSeq   BigInt   @default(0)
  lastHash  String   @default("")
  updatedAt DateTime @updatedAt
}

// Singleton (id = "singleton") holding the outbound SMTP relay configuration.
model SmtpConfig {
  id        String   @id
  host      String
  port      Int
  secure    Boolean  @default(false)
  username  String
  password  String
  fromName  String
  fromEmail String
  enabled   Boolean  @default(false)
  updatedAt DateTime @updatedAt
}

model Notification {
  id        String    @id @default(cuid())
  type      String // "site_down" | "site_recovered"
  siteId    String?
  siteName  String
  detail    String?
  createdAt DateTime  @default(now())
  readAt    DateTime?

  @@index([readAt])
  @@index([createdAt])
}
