// Captivo Access — Manager database schema.
// Slice 1: identity + passkey (User, Passkey, TotpSecret, Invite, Session).
// NOT multi-tenant — single-org self-host.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  OPERATOR
  AUDITOR
  STAFF
  VENDOR
}

enum UserStatus {
  ACTIVE
  DISABLED
}

model User {
  id             String        @id @default(cuid())
  email          String        @unique
  name           String
  phone          String?
  company        String?
  role           Role
  status         UserStatus    @default(ACTIVE)
  createdAt      DateTime      @default(now())
  passkeys       Passkey[]
  totp           TotpSecret?
  sessions       Session[]
  invitesCreated Invite[]      @relation("InviteCreator")
  grantsSubject  AccessGrant[] @relation("GrantSubject")
  grantsApproved AccessGrant[] @relation("GrantApprover")
  grantsCreated  AccessGrant[] @relation("GrantCreator")

  directoryManaged        Boolean   @default(false)
  directoryLastVerifiedAt DateTime?
}

model Passkey {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  credentialId String    @unique // base64url
  publicKey    Bytes // COSE public key (not sensitive — public)
  counter      BigInt    @default(0)
  transports   String[] // usb/nfc/ble/internal/hybrid
  label        String // "iPhone", "Laptop" — user-facing label
  createdAt    DateTime  @default(now())
  lastUsedAt   DateTime?

  @@index([userId])
}

model TotpSecret {
  userId      String    @id // 1:1
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  secret      String // AES-256-GCM encrypted (crypto.ts)
  confirmedAt DateTime? // set once enrollment is verified
}

model Invite {
  id          String    @id @default(cuid())
  email       String
  name        String
  phone       String?
  company     String?
  role        Role
  tokenHash   String    @unique // argon2(random 32B); plaintext only in the link
  expiresAt   DateTime
  usedAt      DateTime?
  createdById String?
  createdBy   User?     @relation("InviteCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())

  @@index([email])
}

model Session {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String   @unique // sha256(opaque random); plaintext token lives in the cookie
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())
  userAgent  String?
  ip         String?

  @@index([userId])
}

enum ConnectorStatus {
  PENDING
  ONLINE
  OFFLINE
  REVOKED
}

enum SiteAccessMode {
  TRANSPARENT
  GATEWAY
}

model Connector {
  id         String          @id @default(cuid())
  name       String
  tokenHash  String          @unique
  status     ConnectorStatus @default(PENDING)
  lastSeenAt DateTime?
  version    String?
  gatewayHost Boolean @default(false)
  remoteAddr String?
  egressPolicy String?
  logLevel   String?         @default("info") // debug | info | warn | error — pushed to the connector live
  createdAt  DateTime        @default(now())
  sites      Site[]
  pairings   ConnectorPairing[]
}

model ConnectorPairing {
  id          String     @id @default(cuid())
  codeHash    String
  name        String
  gatewayHost Boolean    @default(false)
  connectorId String?
  connector   Connector? @relation(fields: [connectorId], references: [id], onDelete: Cascade)
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime   @default(now())
}

model Site {
  id                 String        @id @default(cuid())
  connectorId        String
  connector          Connector     @relation(fields: [connectorId], references: [id], onDelete: Cascade)
  name               String
  hostname           String        @unique
  upstreamUrl        String?
  insecureSkipVerify Boolean       @default(false)
  description        String?
  probedAt           DateTime?
  probeOk            Boolean?
  probeDetail        String?
  probeLatencyMs     Int?
  recordSessions     Boolean       @default(false)
  clipboardMode      String        @default("allow") // allow | no_copy | no_paste | none (transparent only)
  accessMode         SiteAccessMode @default(TRANSPARENT)
  logo               Bytes?
  logoType           String?
  createdAt          DateTime      @default(now())
  grants             AccessGrant[]
  groupMappings      GroupMapping[]
}

enum GrantStatus {
  ACTIVE
  REVOKED
  DENIED
}

model AccessGrant {
  id       String      @id @default(cuid())
  userId   String
  user     User        @relation("GrantSubject", fields: [userId], references: [id], onDelete: Cascade)
  siteId   String
  site     Site        @relation(fields: [siteId], references: [id], onDelete: Cascade)
  startsAt DateTime?
  endsAt   DateTime?
  status   GrantStatus @default(ACTIVE)
  note     String?
  denyReason String?

  requiresApproval Boolean   @default(false)
  approvedAt       DateTime?
  approvedById     String?
  approvedBy       User?     @relation("GrantApprover", fields: [approvedById], references: [id], onDelete: SetNull)

  schedule Json?

  createdById String?
  createdBy   User?    @relation("GrantCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())

  directoryManaged Boolean @default(false)

  @@index([userId, siteId])
}

enum AuditDecision {
  ALLOW
  DENY
}

model AuditEvent {
  id        String        @id @default(cuid())
  timestamp DateTime      @default(now())
  userId    String?
  userEmail String?
  userName  String?
  company   String?
  siteId    String?
  siteName  String?
  host      String
  method    String
  path      String
  status    Int
  bytesOut  BigInt        @default(0)
  decision  AuditDecision
  reason    String?
  clientIp  String?
  userAgent String?
  seq       BigInt        @unique
  prevHash  String        @default("")
  hash      String        @default("")
  createdAt DateTime      @default(now())

  @@index([timestamp])
  @@index([userId, timestamp])
  @@index([siteId, timestamp])
  @@index([seq])
}

// Singleton (id = "singleton") holding the tamper-evidence chain head.
model AuditChainState {
  id        String   @id
  lastSeq   BigInt   @default(0)
  lastHash  String   @default("")
  updatedAt DateTime @updatedAt
}

// Singleton (id = "singleton") holding the outbound SMTP relay configuration.
model SmtpConfig {
  id        String   @id
  host      String
  port      Int
  secure    Boolean  @default(false)
  username  String
  password  String
  fromName  String
  fromEmail String
  enabled            Boolean  @default(false)
  lastVerifiedAt     DateTime?
  lastVerifiedOk     Boolean?
  lastVerifiedDetail String?
  updatedAt DateTime @updatedAt
}

model Notification {
  id        String    @id @default(cuid())
  type      String // "site_down" | "site_recovered"
  siteId    String?
  siteName  String
  detail    String?
  createdAt DateTime  @default(now())
  readAt    DateTime?

  @@index([readAt])
  @@index([createdAt])
}

// Singleton (id = "singleton") holding OIDC SSO configuration.
model OidcConfig {
  id           String   @id
  enabled      Boolean  @default(false)
  issuer       String
  clientId     String
  clientSecret String                  // encrypted at rest (lib/crypto)
  buttonLabel        String?
  lastVerifiedAt     DateTime?
  lastVerifiedOk     Boolean?
  lastVerifiedDetail String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// Singleton (id = "singleton") holding GitHub release check configuration.
model DirectoryConfig {
  id                 String    @id
  enabled            Boolean   @default(false)
  connectorId        String?
  host               String    @default("")
  port               Int       @default(389)
  security           String    @default("STARTTLS") // PLAIN | STARTTLS | LDAPS
  insecureSkipVerify Boolean   @default(false)
  baseDN             String    @default("")
  bindDN             String    @default("")
  bindPassword       String    @default("") // encrypted at rest (lib/crypto)
  lastTestedAt       DateTime?
  lastTestOk         Boolean?
  lastTestDetail     String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

model GroupMapping {
  id        String   @id @default(cuid())
  groupDN   String   // full DN, e.g. "CN=Captivo-Admins,OU=Groups,DC=corp,DC=local"
  kind      String   // "ROLE" | "SITE"
  role      Role?    // set when kind = "ROLE": ADMIN | OPERATOR | AUDITOR
  siteId    String?  // set when kind = "SITE"
  site      Site?    @relation(fields: [siteId], references: [id], onDelete: Cascade)
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([groupDN])
}

model SessionPolicy {
  id                   String   @id
  idleTimeoutMinutes   Int?
  maxSessionHours      Int?
  maxConcurrentPerUser Int?
  updatedAt            DateTime @updatedAt
}

// PlatformSettings is a singleton (id = "singleton") holding tenant-wide
// operational settings that were previously env-only. Each field is optional;
// an unset field falls back to its former env var, then a hard default, so an
// existing deployment keeps working and the env var becomes optional.
model PlatformSettings {
  id                     String   @id
  auditRetentionDays     Int? // was AUDIT_RETENTION_DAYS (default 730)
  inviteTtlHours         Int? // was INVITE_TTL_HOURS (default 48)
  notificationWebhookUrl String? // was NOTIFICATION_WEBHOOK_URL
  vendorIpAllowlist      String? // CIDRs/IPs; empty = no restriction. Gates vendor SITE access only.
  maxGrantDays           Int? // cap on a grant's duration; 0/null = no cap (permanent grants allowed)
  recordingConsentRequired Boolean? // was RECORDING_CONSENT_REQUIRED; null = env fallback → false
  recordingRetentionDays Int? // auto-delete recordings older than N days; 0/null = keep forever
  updatedAt              DateTime @updatedAt
}

model UpdateCheckConfig {
  id            String    @id
  enabled       Boolean   @default(true)
  latestVersion String?
  latestUrl     String?
  lastCheckedAt DateTime?
  lastCheckOk   Boolean?
  updatedAt     DateTime  @updatedAt
}

model SessionRecording {
  id           String           @id @default(cuid())
  recordingKey String           @unique
  siteId       String
  userId       String
  host         String
  startedAt    DateTime         @default(now())
  lastEventAt  DateTime         @default(now())
  eventCount   Int              @default(0)
  bytes        Int              @default(0)
  chunks       RecordingChunk[]

  @@index([siteId])
  @@index([userId])
  @@index([startedAt])
}

model RecordingChunk {
  id          String           @id @default(cuid())
  recordingId String
  seq         Int
  data        Bytes
  createdAt   DateTime         @default(now())
  recording   SessionRecording @relation(fields: [recordingId], references: [id], onDelete: Cascade)

  @@index([recordingId, seq])
}
