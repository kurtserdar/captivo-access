# Captivo Access — production front proxy (Caddy, automatic HTTPS).
#
# Routes:
#   manager.{$ACCESS_DOMAIN}  -> access-manager:3100   (console, auth, invites, APIs)
#   *.{$ACCESS_DOMAIN}        -> access-dataplane:3103  (per-site identity-aware proxy)
#
# Caddy sets X-Forwarded-For / X-Forwarded-Host / X-Forwarded-Proto on
# reverse_proxy by default — both backends rely on these (see
# dataplane/browserproxy.go and the repo README's "Reverse proxy access"
# section), so do not strip or override them.
#
# ACCESS_DOMAIN and DNS_API_TOKEN come from docker-compose.prod.yml's
# environment (sourced from .env — see .env.prod.example).

# On-Demand TLS: issue a certificate for a vendor-app hostname the first time it
# is requested (HTTP-01, no DNS plugin / token / provider lock-in). Caddy asks
# the manager first, so it only ever issues for hostnames that are configured
# Sites — never arbitrary names. See src/app/api/internal/tls-check.
{
	on_demand_tls {
		ask http://access-manager:3100/api/internal/tls-check
	}
}

# --- Manager console: works out of the box via HTTP-01 (no DNS plugin needed) ---
manager.{$ACCESS_DOMAIN} {
	reverse_proxy access-manager:3100
}

# --- Connector tunnel (WSS): TLS termination for the data-plane's :3101 ---
#
# The data-plane serves the connector WebSocket on :3101 as PLAIN HTTP (it does
# not terminate TLS itself), and docker-compose.prod.yml does not publish that
# port on the host. This single-hostname block gives the tunnel real TLS via
# HTTP-01 (no DNS plugin / wildcard needed) so connectors dial in over wss://.
# Caddy transparently proxies the WebSocket upgrade + the long-lived yamux
# stream that rides on it. Point connectors at wss://connect.{$ACCESS_DOMAIN}.
connect.{$ACCESS_DOMAIN} {
	reverse_proxy access-dataplane:3101
}

# --- Per-site vendor access: any <app>.{$ACCESS_DOMAIN} -> identity-aware proxy ---
#
# Automatic HTTPS via On-Demand TLS: the cert for each app hostname is issued on
# first request over HTTP-01 (no DNS plugin, no API token, works with any DNS
# provider). Requires only a single wildcard DNS A record
# (*.{$ACCESS_DOMAIN} -> this server) so the app hostnames resolve here. The
# global on_demand_tls block above gates issuance via the manager's ask endpoint.
#
# For very large deployments that would exceed Let's Encrypt's per-domain new-cert
# rate limit, use the DNS-01 wildcard-cert escape hatch instead — one cert for
# *.{$ACCESS_DOMAIN} via docker-compose.dns.override.yml (see README "Wildcard TLS").
*.{$ACCESS_DOMAIN} {
	tls {
		on_demand
	}
	reverse_proxy access-dataplane:3103
}
