# Captivo Access — Pro session gateway (Guacamole) environment.
# `./setup.sh` writes this file for you (with a random password). You normally
# don't touch it — only if you want to change the local admin port.

# Password for the Guacamole Postgres DB (setup.sh fills this with a random hex).
GUAC_DB_PASSWORD=

# Host port for local admin access to the Guacamole UI (default 8080). Change it
# if 8080 is already used on this host. The connector doesn't use this port.
# GUAC_PORT=8080
