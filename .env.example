# Captivo Access Manager — environment variables template.
# Create your .env with real values (never commit it).

# PostgreSQL connection (inside docker-compose: host=access-postgres)
DATABASE_URL=postgresql://access:CHANGE_ME@access-postgres:5432/captivo_access

# Postgres password for docker-compose (must match DATABASE_URL)
POSTGRES_PASSWORD=CHANGE_ME

# Session signing secret — openssl rand -hex 32
SESSION_SECRET=CHANGE_ME

# WebAuthn Relying Party ID (used starting Slice 1) — the Manager's domain
# e.g. access.example.com  (localhost for local dev: localhost)
WEBAUTHN_RP_ID=localhost

# TOTP secret encryption (AES-256-GCM) — openssl rand -hex 32
ENCRYPTION_KEY=CHANGE_ME
# Invite link validity period (hours)
INVITE_TTL_HOURS=48
# Session duration (hours, sliding)
SESSION_TTL_HOURS=12
