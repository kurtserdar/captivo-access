# Captivo Access Manager — ortam değişkenleri şablonu.
# Gerçek değerlerle .env oluşturun (asla commit'lemeyin).

# PostgreSQL bağlantısı (docker-compose içi: host=access-postgres)
DATABASE_URL=postgresql://access:CHANGE_ME@access-postgres:5432/captivo_access

# Oturum imza sırrı — openssl rand -hex 32
SESSION_SECRET=CHANGE_ME

# WebAuthn Relying Party ID (Dilim 1'de kullanılacak) — Manager'ın alan adı
# ör. access.firma.com  (localhost geliştirmede: localhost)
WEBAUTHN_RP_ID=localhost
