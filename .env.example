# Captivo Access Manager — environment variables template.
# Create your .env with real values (never commit it).

# PostgreSQL connection (inside docker-compose: host=access-postgres)
DATABASE_URL=postgresql://access:CHANGE_ME@access-postgres:5432/captivo_access

# Postgres password for docker-compose (must match DATABASE_URL)
POSTGRES_PASSWORD=CHANGE_ME

# Session signing secret — openssl rand -hex 32
SESSION_SECRET=CHANGE_ME

# WebAuthn Relying Party ID (used starting Slice 1) — the Manager's domain
# e.g. access.example.com  (localhost for local dev: localhost)
WEBAUTHN_RP_ID=localhost

# TOTP secret encryption (AES-256-GCM) — openssl rand -hex 32
ENCRYPTION_KEY=CHANGE_ME
# Invite link validity period (hours)
INVITE_TTL_HOURS=48
# Session duration (hours, sliding)
SESSION_TTL_HOURS=12

# Shared secret between the Manager and the data-plane's internal API (Slice 2)
# openssl rand -hex 32
DATAPLANE_SECRET=CHANGE_ME

# Session cookie domain (Slice 4) — leave empty for local/dev (host-only
# cookie). In production, set to a leading-dot domain that covers both the
# Manager and every vendor site subdomain, e.g. .access.example.com, so the
# session cookie is readable across subdomains for cross-subdomain SSO.
COOKIE_DOMAIN=

# The Manager's own public URL, used by the data-plane to build absolute
# login redirects (e.g. https://manager.access.example.com in production).
MANAGER_PUBLIC_URL=http://localhost:3100

# How long AuditEvent rows are kept (days) before POST /api/cron/audit-retention
# deletes them. Set per your legal counsel — KVKK/5651 retention obligations.
AUDIT_RETENTION_DAYS=730

# Bearer secret that authorizes POST /api/cron/audit-retention. Leave empty to
# keep the retention cron disabled (the endpoint fails closed without it).
# openssl rand -hex 32
CRON_SECRET=

# Bounded in-memory audit-event queue depth on the data-plane before it starts
# dropping events rather than blocking the proxy.
AUDIT_QUEUE_CAP=10000
